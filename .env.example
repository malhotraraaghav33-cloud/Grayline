# ==============================================================================
# GRAYLINE // Emergency Medical Triage & Evacuation Logistics Platform
# Environment Configuration (.env.example)
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT="development"
PROJECT_NAME="GRAYLINE Field Terminal"
API_V1_STR="/api"

# Database Configuration
# In development, defaults to local SQLite file (sqlite:///./grayline_tactical.db)
# For production PostgreSQL: postgresql://grayline_user:secure_password@localhost:5432/grayline_db
DATABASE_URL="sqlite:///./grayline_tactical.db"

# Security & JWT Authentication
# IMPORTANT: Generate a secure 32+ character key for production (e.g. `openssl rand -hex 32`)
JWT_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://localhost:3000"

# Rate Limiting (requests per minute per IP on sensitive auth endpoints)
RATE_LIMIT_PER_MINUTE=60

# Optional External GPU Inference Service
# If left blank or unset, GRAYLINE runs deterministically using local validated demo rules.
# Point to an approved containerized model server (e.g., http://gpu-worker:8080/v1/triage)
INFERENCE_SERVICE_URL=""
INFERENCE_SERVICE_API_KEY=""
INFERENCE_TIMEOUT_SECONDS=5.0

# Server Binding
HOST="0.0.0.0"
PORT=8000
